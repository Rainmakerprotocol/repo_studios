{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Function Analysis Schema",
  "description": "Schema for the JSON payload emitted by generate_function_analysis.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "summary", "findings"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 0 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_version",
        "generated_at",
        "folder_path",
        "folder_name",
        "repo_root",
        "source_index_file",
        "source_index_generated_at",
        "source_index_hash"
      ],
      "properties": {
        "analysis_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "folder_path": { "type": "string" },
        "folder_name": { "type": "string" },
        "repo_root": { "type": "string" },
        "source_index_file": { "type": "string" },
        "source_index_generated_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "source_index_hash": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_groups",
        "total_duplicate_functions",
        "total_files_scanned"
      ],
      "properties": {
        "duplicate_groups": { "type": "integer", "minimum": 0 },
        "total_duplicate_functions": { "type": "integer", "minimum": 0 },
        "total_files_scanned": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "severity",
          "summary",
          "details",
          "metrics",
          "action_items",
          "instances"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "severity": { "type": "string" },
          "summary": { "type": "string" },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "function_name",
              "signature",
              "shared_docstring",
              "line_counts"
            ],
            "properties": {
              "function_name": { "type": "string" },
              "signature": { "type": "string" },
              "shared_docstring": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "null" }
                ]
              },
              "line_counts": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "null" }
                  ]
                }
              },
              "qualified_names": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                }
              },
              "hash": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "null" }
                ]
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duplicate_count"],
            "properties": {
              "duplicate_count": { "type": "integer", "minimum": 0 },
              "todo_tags": { "type": "integer", "minimum": 0 }
            }
          },
          "action_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "targets"],
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "targets": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "docstring",
                "line",
                "path",
                "signature",
                "line_count"
              ],
              "properties": {
                "name": { "type": "string" },
                "docstring": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                },
                "line": { "type": "integer", "minimum": 0 },
                "path": { "type": "string" },
                "signature": { "type": "string" },
                "line_count": {
                  "anyOf": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "null" }
                  ]
                },
                "qualified_name": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                },
                "module_id": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                },
                "hash": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                },
                "returns_kind": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "null" }
                  ]
                },
                "todo_tags": { "type": "integer", "minimum": 0 },
                "io_effects": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reads", "writes", "env", "network"],
                  "properties": {
                    "reads": { "type": "boolean" },
                    "writes": { "type": "boolean" },
                    "env": { "type": "boolean" },
                    "network": { "type": "boolean" }
                  }
                },
                "logging_calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["level", "lineno"],
                    "properties": {
                      "level": { "type": "string" },
                      "lineno": { "type": "integer", "minimum": 0 }
                    }
                  }
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["callee", "lineno"],
                    "properties": {
                      "callee": { "type": "string" },
                      "lineno": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
